# ==============================================================================
# UBP Bot — Environment Configuration Template (.env.example)
# NOTICE: NEVER commit real credentials, tokens, or banking keys to source control.
# Copy this file to .env and configure local workstation environment variables.
# ==============================================================================

# System A: OTC BPS Portal Configuration (Manual Login & 2FA)
OTC_PORTAL_LOGIN_URL=http://localhost:5173/
OTC_PORTAL_TIMEOUT_MS=30000
OTC_PORTAL_SEARCH_TIMEOUT_MS=15000

# System B: GNB Core Banking Portal Configuration
GNB_LOGIN_URL=http://127.0.0.1:8080/gnb/login
GNB_REJECTED_TRANSACTIONS_URL=http://127.0.0.1:8080/gnb/rejected-transactions
GNB_USERNAME=
GNB_PASSWORD=

# Playwright Browser Runtime Options
# Use 'msedge' or 'chrome' to utilize Windows pre-installed enterprise browsers
BROWSER_CHANNEL=
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=100
BROWSER_USER_DATA_DIR=checkpoints/browser_profile

# Dynamic Directory Configuration (Defaults; user-customizable in GUI)
INPUT_DIR=input
OUTPUT_DIR=output
PROCESSING_DIR=processing
COMPLETED_DIR=completed
FAILED_DIR=failed
LOGS_DIR=logs
CHECKPOINTS_DIR=checkpoints
